# Choose ONE provider setup below.

# ---- Option A: Anthropic direct (default if LLM_PROVIDER unset) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# ---- Option B: OpenRouter (one key, many models) ----
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-fable-5
# Other model options: openai/gpt-4o, meta-llama/llama-3.1-70b-instruct, etc.
# Full list: https://openrouter.ai/models

# ---- Database (optional - defaults to local SQLite) ----
# DATABASE_URL=postgresql://user:pass@localhost:5432/ops_copilot
